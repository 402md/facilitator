{
  "name": "402md",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@402md/relay --filter=@402md/worker --filter=@402md/shared",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --check",
      "eslint"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "turbo": "^2.9.14",
    "typescript": "^5",
    "typescript-eslint": "^8.58.0"
  },
  "overrides": {
    "protobufjs": "^7.5.8",
    "@protobufjs/utf8": "^1.1.1",
    "axios": "^1.15.2",
    "fast-uri": "^3.1.2",
    "ws": "^8.20.1",
    "uuid": "^11.1.1",
    "hono": "^4.12.18",
    "ip-address": "^10.1.2",
    "follow-redirects": "^1.15.12",
    "qs": "^6.15.2",
    "brace-expansion": "^5.0.6",
    "postcss": "^8.5.10",
    "vite": "^7.3.2",
    "esbuild": "^0.25.0"
  }
}
